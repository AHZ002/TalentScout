TALENTSCOUT_APP_NAME=TalentScout API

TALENTSCOUT_APP_VERSION=0.1.0

TALENTSCOUT_ENVIRONMENT=development

TALENTSCOUT_DEBUG=false

TALENTSCOUT_DATABASE_URL=postgresql+psycopg://talentscout:talentscout@localhost:5432/talentscout

TALENTSCOUT_JINA_API_KEY=

TALENTSCOUT_EMBEDDING_MODEL=jina-embeddings-v5-text-small

TALENTSCOUT_EMBEDDING_DIMENSIONS=1024

# Groq API key used by TalentScout's interview agents.
TALENTSCOUT_GROQ_API_KEY=

# LLM used by the interview agents.
TALENTSCOUT_LLM_MODEL=openai/gpt-oss-20b